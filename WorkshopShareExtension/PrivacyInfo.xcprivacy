<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest for the "Add to Workshop" share extension.

  An embedded extension is its own binary and needs its own manifest, or the
  upload fails ITMS-91053 on this target even though the app target is clean.

  The extension collects nothing: it has no WorkshopAPI and never opens a
  connection. It hands the shared URL or image to `ShareQueue` in the App Group
  and the app does the upload on next launch — so the only entry is that
  defaults access.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- 1C8F.1 — writes the queue into group.com.nintek.workshop. -->
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
